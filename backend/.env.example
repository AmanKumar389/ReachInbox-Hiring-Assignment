# ---- Server ----
PORT=4000
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# ---- Infra ----
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---- Google OAuth (same client id as the frontend) ----
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ---- Slack OAuth (app with the incoming-webhook scope) ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must exactly match a Redirect URL in the Slack app settings
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ---- Ethereal senders ----
# Leave empty to auto-create SENDER_COUNT Ethereal accounts on first boot.
# Or provide JSON: [{"name":"Alice","user":"x@ethereal.email","pass":"..."}]
ETHEREAL_SENDERS=
SENDER_COUNT=3

# ---- Scheduler / throughput ----
QUEUE_NAME=email-send
WORKER_CONCURRENCY=5
# Global minimum gap between two SMTP sends, across all workers (BullMQ limiter)
MIN_SEND_DELAY_MS=2000
# Hard ceiling per sender per clock hour (Redis counters)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Default per-campaign hourly limit when the UI does not send one
DEFAULT_CAMPAIGN_HOURLY_LIMIT=100
JOB_ATTEMPTS=3
# How long a "sending" claim is held before another worker may take over
SEND_LOCK_TTL_MS=60000

# ---- BullMQ dashboard (/admin/queues) ----
BULL_BOARD_USER=admin
BULL_BOARD_PASS=admin
